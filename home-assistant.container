[Container]
Image=ghcr.io/home-assistant/home-assistant:2026.10.4@sha256:23f4dfbb69ce76315dbc4de7915504f1c2dcecd7ca2648113a493a385972e133
ContainerName=home-assistant

Network=host

Timezone=local

Volume=%h/containers/home-assistant:/config:U,Z

UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=wget --no-verbose --tries=1 --spider http://localhost:8123/ || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:8123/ || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

StopTimeout=60

Memory=1.5G
PidsLimit=256

[Service]
CPUQuota=200%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/home-assistant

[Install]
WantedBy=default.target
