[Container]
Image=ghcr.io/home-assistant/home-assistant:2026.10.3@sha256:407b89cd11a8cb67d388d21739a226c74acbbebe1ac59e3b83b11b43ce76b98f
ContainerName=home-assistant

Network=host

Timezone=local

Volume=%h/containers/home-assistant:/config:U,Z

UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=wget --no-verbose --tries=1 --spider http://localhost:8123/ || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:8123/ || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

StopTimeout=60

Memory=1.5G
PidsLimit=256

[Service]
CPUQuota=200%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/home-assistant

[Install]
WantedBy=default.target
