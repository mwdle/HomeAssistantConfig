[Container]
Image=docker.io/nicolargo/glances:4.5.8@sha256:32ccbc559baa624bd41419c9a1daf2c32b391dfbee106434186a52bccd164ac7
ContainerName=glances

Network=glances.network

PublishPort=127.0.0.1:61208:61208

Timezone=local

# Enable webserver mode (which is required to use the Home Assistant integration)
Environment=GLANCES_OPT="-w --disable-webui"

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,nosuid

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:61208/api/4/status || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:61208/api/4/status || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=50

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
