[Container]
Image=docker.io/library/eclipse-mosquitto:2.1.2-alpine@sha256:860aeb5d63ce509508f6dcfb2bc8a1c1dd2bc60555b562b45ce90e52d8dabb0f
ContainerName=mqtt

Network=mqtt.network

PublishPort=127.0.0.1:1883:1883
PublishPort=127.0.0.1:9001:9001

Secret=mqtt_password_file,target=mqtt_password,uid=1883,gid=1883,mode=0400

Timezone=local

Volume=./mosquitto.conf:/mosquitto/config/mosquitto.conf:ro,Z

ReadOnly=true
ReadOnlyTmpfs=false

User=mosquitto
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=mosquitto_sub -t check -C 1 -W 4 2>&1 | grep -q 'not authorised' || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=mosquitto_sub -t check -C 1 -W 4 2>&1 | grep -q 'not authorised' || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=32M
PidsLimit=10

[Service]
CPUQuota=25%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
